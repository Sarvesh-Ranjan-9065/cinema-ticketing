# HTTP server configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HOST_PORT=8080

# Logging level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Business logic configuration
HOLD_TTL=120s

# Database connection
# In production/docker, prefer DATABASE_URL_FILE pointing to a mounted secret file.
DATABASE_URL=postgres://cinema_user:change_me@127.0.0.1:5432/cinema_db?sslmode=disable
# DATABASE_URL_FILE=/run/secrets/database_url

# Database connection pool settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=15m

# Compose environment placeholders (used by db container)
POSTGRES_DB=cinema_db
POSTGRES_USER=cinema_user
POSTGRES_PASSWORD=change_me
